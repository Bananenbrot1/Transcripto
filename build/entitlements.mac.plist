<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron to run JIT-compiled JavaScript -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Required for Electron's V8 engine to use unsigned executable memory -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Required for native Node.js addons (whisper.node, sherpa-onnx) -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Microphone access for speech-to-text transcription -->
  <key>com.apple.security.device.audio-input</key>
  <true/>


  <!-- Allow outgoing network connections (model downloads from HuggingFace) -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
